# AI Finance Controller — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Google Gemini API key — required by google-adk and google-genai
GOOGLE_API_KEY=your_google_api_key_here

# Razorpay credentials — used for payment ID schema reference & settlement simulation
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Neon PostgreSQL connection string
# Get this from: Neon dashboard → your project → Connection Details → Connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require

# Set to "false" to skip truncate+reseed on startup (useful when DATABASE_URL
# points to a live database with real data rather than the synthetic batch)
SEED_DB=false

# ---------------------------------------------------------------------------
# Upstash Redis (optional but strongly recommended for production)
# ---------------------------------------------------------------------------
# Used by the Settlement Q&A three-tier cache:
#   Tier 1: Redis cache hit   — < 5 ms, $0 AI cost
#   Tier 2: SQL fast-path     — < 80 ms, $0 AI cost  (common aggregate questions)
#   Tier 3: Gemini LLM agent  — novel/complex questions, result cached for next call
#
# Get credentials from: https://console.upstash.com → Redis → REST API
# If not set, cache is silently disabled and the agent falls back to Tier 2/3 only.
UPSTASH_REDIS_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_TOKEN=<your-rest-token>

# Cache TTL overrides (optional — defaults shown)
QA_CACHE_TTL_SECONDS=300       # Q&A answer cache: 5 minutes
METRICS_CACHE_TTL_SECONDS=60   # Pre-aggregated metric cache: 60 seconds

# ---------------------------------------------------------------------------
# Celery — Background Batch Processing
# ---------------------------------------------------------------------------
# Required for POST /api/run/async (chunked parallel reconciliation).
# POST /api/run (SSE streaming) works without Celery for small batches.
#
# Option A — Upstash Redis (same instance as Q&A cache, different DB index):
#   CELERY_BROKER_URL=rediss://:<token>@<host>.upstash.io:6379/0
#   CELERY_RESULT_BACKEND=rediss://:<token>@<host>.upstash.io:6379/1
#
# Option B — Local Redis (development):
#   CELERY_BROKER_URL=redis://localhost:6379/0
#   CELERY_RESULT_BACKEND=redis://localhost:6379/1
#
# Get Upstash TCP endpoint from: console.upstash.com → Redis → Details → TCP
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Chunk tuning (optional — defaults shown)
CELERY_CHUNK_SIZE=5000          # Payments per parallel worker chunk
CELERY_MAX_CONCURRENCY=8        # Max parallel chunk tasks

# Starting the Celery worker (run from backend/ directory):
#   celery -A worker.celery_app worker --loglevel=info --concurrency=4 -Q finance_batch
#
# Optional Flower monitoring UI (http://localhost:5555):
#   celery -A worker.celery_app flower --port=5555
