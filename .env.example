# AI Finance Controller — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Google Gemini API key — required by google-adk and google-genai
GOOGLE_API_KEY=your_google_api_key_here

# Razorpay credentials — used for payment ID schema reference & settlement simulation
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Neon PostgreSQL connection string
# Get this from: Neon dashboard → your project → Connection Details → Connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require

# Set to "false" to skip truncate+reseed on startup (useful when DATABASE_URL
# points to a live database with real data rather than the synthetic batch)
SEED_DB=false
